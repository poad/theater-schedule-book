{
  "name": "theater-schedule-book",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "rimraf build dist && vite",
    "dev": "rimraf build dist && vite",
    "build": "rimraf build dist && vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "test-watch": "vitest",
    "test-ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "build:clean": "rimraf build dist",
    "lint": "oxfmt --check && oxlint",
    "lint-fix": "oxfmt && oxlint --fix"
  },
  "dependencies": {
    "@solidjs/web": "^2.0.0",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/auth-ui-solid": "^0.3.8",
    "@supabase/supabase-js": "^2.119.0",
    "solid-icons": "^1.2.0",
    "terracotta": "^1.3.2"
  },
  "devDependencies": {
    "@solidjs/router": "^2.0.0",
    "@solidjs/testing-library": "^0.8.10",
    "@solidjs/vite-plugin": "3.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "eslint-plugin-solid": "^0.19.0",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "postcss": "^8.5.32",
    "rimraf": "^6.1.4",
    "solid-js": "^2.0.0",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pages": "^0.33.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24",
    "npm": "echo Please use pnpm!",
    "pnpm": ">=11",
    "yarn": "echo Please use pnpm!"
  }
